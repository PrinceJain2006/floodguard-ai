# ─────────────────────────────────────────────────────────────────────────────
# FloodGuard AI — Streamlit Cloud Secrets Template
#
# HOW TO USE:
#   Streamlit Cloud: paste the KEY = "value" lines into
#   App settings → Secrets  (do NOT include section headers like [ibm])
#
#   Local development: copy this file to .streamlit/secrets.toml and fill in
#   your credentials.  Alternatively, use a .env file in the project root.
#
# SECURITY: Never commit a filled-in secrets.toml to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM WatsonX / Granite ─────────────────────────────────────────────────────
# Required for live IBM Granite responses.
# The API key must have "IBM Watson Machine Learning" service access.
WATSONX_API_KEY    = "your_watsonx_api_key_here"

# The ID of your WatsonX.ai project (found in Project → Manage → General).
WATSONX_PROJECT_ID = "your_project_id_here"

# WatsonX endpoint — change region if your project is not in us-south.
# us-south : https://us-south.ml.cloud.ibm.com
# eu-de    : https://eu-de.ml.cloud.ibm.com
# eu-gb    : https://eu-gb.ml.cloud.ibm.com
# jp-tok   : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL        = "https://us-south.ml.cloud.ibm.com"

# Granite model ID — must be available in your WatsonX project/region.
# ibm/granite-4-h-small is confirmed available on us-south multitenant.
# To discover what models your project supports, query:
#   GET {WATSONX_URL}/ml/v1/foundation_model_specs?version=2024-05-31
GRANITE_MODEL_ID   = "ibm/granite-4-h-small"

# ── App settings ──────────────────────────────────────────────────────────────
# Set DEMO_MODE=false only if you have live municipal data feeds.
DEMO_MODE          = "true"

# ── Optional: Live Weather ────────────────────────────────────────────────────
# Open-Meteo requires no API key. Set to "false" to disable live weather.
LIVE_WEATHER_ENABLED      = "true"
LIVE_DATA_CACHE_TTL       = "600"
LIVE_DATA_REQUEST_TIMEOUT = "8"
LIVE_DATA_STALE_THRESHOLD = "1800"
