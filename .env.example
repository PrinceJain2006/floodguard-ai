# IBM Granite / WatsonX credentials
# On Streamlit Cloud: set these via App settings → Secrets (not this file).
# See .streamlit/secrets.toml.example for the Streamlit Cloud format.
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
# Change region to match your WatsonX project:
# us-south: https://us-south.ml.cloud.ibm.com (default)
# eu-de:    https://eu-de.ml.cloud.ibm.com
# eu-gb:    https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# JWT Secret for authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./floodguard.db

# Backend API
BACKEND_URL=http://localhost:8000

# Demo mode flag (set to "true" to always use synthetic data)
DEMO_MODE=true

# App settings
APP_NAME=FloodGuard AI
APP_VERSION=1.0.0
DEBUG=false

# OpenAI compatible fallback (optional)
OPENAI_API_KEY=

# Weather API (optional - uses synthetic data if not set)
OPENWEATHER_API_KEY=

# IBM Granite model ID
# ibm/granite-4-h-small is confirmed available on us-south multitenant.
# If ibm/granite-3-8b-instruct appears in your project's model list, it may
# also work — use the model ID returned by /ml/v1/foundation_model_specs.
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Live Weather via Open-Meteo (no API key required)
# Set LIVE_WEATHER_ENABLED=false to force DEMO mode
LIVE_WEATHER_ENABLED=true
LIVE_DATA_CACHE_TTL=600
LIVE_DATA_REQUEST_TIMEOUT=8
LIVE_DATA_STALE_THRESHOLD=1800
