# ══════════════════════════════════════════════════════════════════════════════
# FloodGuard AI — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
# On Streamlit Cloud: set these via App settings → Secrets (not this file).
# See .streamlit/secrets.toml.example for the Streamlit Cloud format.
# NEVER commit .env or secrets.toml to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── IBM Granite / WatsonX ────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
# Region-specific base URL:
#   us-south: https://us-south.ml.cloud.ibm.com (default)
#   eu-de:    https://eu-de.ml.cloud.ibm.com
#   eu-gb:    https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — suitable for prototype/Streamlit deployment)
DATABASE_URL=sqlite:///./floodguard.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/floodguard

# ── Demo / Mode flags ────────────────────────────────────────────────────────
# Set DEMO_MODE=true to always use synthetic data regardless of API availability
DEMO_MODE=true

# ── App settings ─────────────────────────────────────────────────────────────
APP_NAME=FloodGuard AI
APP_VERSION=2.0.0
DEBUG=false
BACKEND_URL=http://localhost:8000

# ── Live Weather (Open-Meteo — no API key required) ──────────────────────────
# Set to "false" to force DEMO mode
LIVE_WEATHER_ENABLED=true
LIVE_DATA_CACHE_TTL=600
LIVE_DATA_REQUEST_TIMEOUT=8
LIVE_DATA_STALE_THRESHOLD=1800

# ── Flood Alert Engine thresholds ────────────────────────────────────────────
# Risk score (0–100) thresholds for each alert level
# These are PROTOTYPE thresholds — calibrate with real historical data.
ALERT_THRESHOLD_GREEN=25
ALERT_THRESHOLD_YELLOW=40
ALERT_THRESHOLD_ORANGE=60
ALERT_THRESHOLD_RED=75
# Seconds before the same location can trigger another alert (30 min default)
ALERT_COOLDOWN_SECONDS=1800

# ── Email Notifications (optional) ───────────────────────────────────────────
# Set EMAIL_ENABLED=true and fill all fields to enable email alerts.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=FloodGuard AI <alerts@example.com>
# Comma-separated list of alert recipients
ALERT_RECIPIENTS=ops@example.com,manager@example.com

# ── SMS Notifications (optional — Twilio) ────────────────────────────────────
# Set SMS_ENABLED=true and fill all fields to enable SMS alerts.
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER=+1xxxxxxxxxx
# Comma-separated list of recipient phone numbers (E.164 format)
SMS_RECIPIENTS=+91xxxxxxxxxx,+91yyyyyyyyyy

# ── Webhook Notifications (optional) ─────────────────────────────────────────
# Set WEBHOOK_ENABLED=true and WEBHOOK_URL to send alert JSON to your system.
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-system.example.com/flood-alert
# Optional HMAC secret for request signing (X-FloodGuard-Signature header)
WEBHOOK_SECRET=

# ── Test Mode ────────────────────────────────────────────────────────────────
# Set to "true" ONLY during development/demo to allow test notification sends.
# Test notifications will always include "TEST ALERT — NOT A REAL EMERGENCY" label.
# NEVER set to "true" in a production/operational deployment.
TEST_NOTIFICATION_MODE=false

# ── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── NWDP / Gujarat SW GW Telemetry API (optional — enables LIVE API mode) ───
# Leave NWDP_API_URL blank to use the local CSV fallback (default behaviour).
#
# HOW TO OBTAIN:
#   1. Register at https://data.gov.in  (Government of India Open Data portal).
#   2. Search for the NWDP water level telemetry dataset for Gujarat SW GW.
#      Dataset title contains: "Gujarat SW GW Sabarmati" or "Water Level Telemetry"
#   3. Click "API" on the dataset page to get your resource_id and API key.
#   4. Your endpoint will look like:
#      https://api.data.gov.in/resource/{resource_id}?format=json&offset=0&limit=100
#   5. Your API key will be a UUID-like string from your data.gov.in dashboard.
#
# NWDP note: the NWDP portal (nwdp.india.gov.in) is the upstream source;
# data.gov.in often mirrors it with a public API endpoint.
#
# CURRENT STATUS (as of this release):
#   No verified public REST API endpoint for this specific dataset has been
#   confirmed reachable. Set NWDP_API_URL when you have a verified URL.
#   Until then, the CSV fallback provides the full historical dataset.
#
NWDP_API_URL=
# Example: https://api.data.gov.in/resource/YOUR_RESOURCE_ID?format=json&offset=0&limit=100

NWDP_API_KEY=
# Your data.gov.in API key (UUID format). Leave blank if the endpoint is keyless.

# If the key should be sent as a query parameter instead of an "api-key" header:
NWDP_API_KEY_PARAM=
# Example: api-key  (sends ?api-key=YOUR_KEY as a query param)

# Refresh interval in seconds (default: 3600 = 1 hour, matching NWDP update frequency)
NWDP_REFRESH_INTERVAL=3600

# HTTP request timeout in seconds (default: 10)
NWDP_API_TIMEOUT=10

# Field-name overrides — only needed if the live API uses different column names
# than the CSV. Leave blank to use CSV defaults.
NWDP_STATION_NAME_FIELD=
NWDP_WL_FIELD=
NWDP_TS_FIELD=
NWDP_TS_FORMAT=

# ── Optional API keys ────────────────────────────────────────────────────────
# These are not required for core functionality.
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
